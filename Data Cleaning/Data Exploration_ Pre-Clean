[i])\n","            axs[i].axis('off')\n","\n","        if dataset.RasterCount >= 4:\n","            # Assuming the fourth channel is grayscale\n","            fourth_channel = dataset.GetRasterBand(4).ReadAsArray()\n","            axs[3].imshow(fourth_channel, cmap=colors[3])\n","            axs[3].set_title(channel_titles[3])\n","            axs[3].axis('off')\n","\n","        plt.tight_layout()\n","        plt.show()\n","\n","    else:\n","        print(\"The image does not have enough channels to display as RGB.\")\n","\n","# Visualization\n","root_dir = Path('/gdrive/My Drive/SpaceNet7/train')  # Adjust path as needed\n","example_image_path = root_dir / 'L15-1672E-1207N_6691_3363_13' / 'images_masked' / 'global_monthly_2018_01_mosaic_L15-1672E-1207N_6691_3363_13.tif'\n","analyze_and_visualize_channels(example_image_path)\n","\n","# OTHER AOIS: L15-0331E-1257N_1327_3160_13, L15-0760E-0887N_3041_4643_13, L15-1289E-1169N_5156_3514_13, L15-1672E-1207N_6691_3363_13"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":930},"id":"rodAv8_0W0x8","executionInfo":{"status":"ok","timestamp":1712783584767,"user_tz":420,"elapsed":5715,"user":{"displayName":"Zachary Luttrell","userId":"00155576860657313600"}},"outputId":"67c5884a-5714-44be-fb5f-199e9f6cd7a8"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["Image global_monthly_2018_01_mosaic_L15-1672E-1207N_6691_3363_13.tif has 4 channels.\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x500 with 4 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["**EXPLORING THE GEOJSON LABELS**\n","\n","Here I will explore the geojson files which make up the building footprint labels for our dataset.  Below are a few things that I will explore:\n","- Coordinate System\n","- Projection\n","- File Contents Overview\n",